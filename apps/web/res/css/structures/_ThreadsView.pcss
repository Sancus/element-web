.mx_ThreadsView {
    display: flex;
    flex-direction: column;
    /* Fills the centre panel, which is itself a flex child of the app layout. */
    flex: 1;
    min-width: 0;
    min-height: 0;
    background-color: $background;
}

/* Element does not reset the user agent's button chrome, so every bare button in this view arrives
   with a border, a grey fill and a rounded box of its own, whether or not it wants one. Listed by
   name rather than as a descendant selector, which would also strip the composer's and the event
   tiles' own buttons. The rules below opt each control back in to the box it actually wants. */
.mx_ThreadsView_newActivityButton,
.mx_ThreadsView_loadMore,
.mx_ThreadCard_roomButton,
.mx_ThreadCard_replyPrompt,
.mx_ThreadCard_collapse,
.mx_ThreadCard_loadEarlier,
.mx_ThreadCard_showMore {
    border: none;
    background: none;
    cursor: pointer;
}

.mx_ThreadsView_header {
    display: flex;
    flex-direction: column;
    gap: var(--cpd-space-3x);
    padding: var(--cpd-space-4x) var(--cpd-space-6x);
    border-bottom: 1px solid $separator;
    flex-shrink: 0;
}

.mx_ThreadsView_headerRow {
    display: flex;
    align-items: center;
    gap: var(--cpd-space-3x);
}

.mx_ThreadsView_heading {
    margin: 0;
    flex-grow: 1;
    color: $primary-content;
}

.mx_ThreadsView_markAllRead {
    flex-shrink: 0;
}

/* On its own row below the title, where the room list keeps its filters, so that the two read as
   the same control in two places rather than as two different ones. */
.mx_ThreadsView_filters {
    display: flex;
    align-items: center;
    gap: var(--cpd-space-2x);
    flex-wrap: wrap;
}

.mx_ThreadsView_scroller {
    flex-grow: 1;
    overflow-y: auto;
    padding: var(--cpd-space-4x) var(--cpd-space-6x) var(--cpd-space-8x);
    display: flex;
    flex-direction: column;
    gap: var(--cpd-space-6x);
    /* The quiet surface, so that the cards on it are the ones that read as paper. The header keeps
       the page background, as the room view's does. */
    background-color: $system;

    /* With no cards there is nothing for the quiet surface to sit behind, and the shared empty
       state's icon is set on that same grey, so it would disappear into it. */
    &:has(.mx_EmptyState) {
        background-color: $background;
    }
}

.mx_ThreadsView_spinner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--cpd-space-3x);
    justify-content: center;
    padding: var(--cpd-space-6x) 0;
}

.mx_ThreadsView_searching {
    color: $secondary-content;
    font: var(--cpd-font-body-sm-regular);
}

/* Stays put at the top of the scroller so that the feed being out of date is visible from wherever
   the user has read to, rather than only from the top. Left in the tree while empty so that its
   status role is present for a screen reader to announce into. */
.mx_ThreadsView_newActivity {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    justify-content: center;
    /* Contributes nothing to the flex gap while there is nothing to say. */
    margin-bottom: calc(-1 * var(--cpd-space-6x));

    &:has(.mx_ThreadsView_newActivityButton) {
        margin-bottom: 0;
    }
}

.mx_ThreadsView_newActivityButton {
    padding: var(--cpd-space-1x) var(--cpd-space-4x);
    border-radius: var(--cpd-space-4x);
    background: var(--cpd-color-bg-action-primary-rest);
    color: var(--cpd-color-text-on-solid-primary);
    font: var(--cpd-font-body-sm-medium);
    /* Literal rather than a token: Compound exposes no shadow tokens, and this matches the
       elevation other surfaces that float over content use. */
    box-shadow: 0 4px 24px 0 rgb(27, 29, 34, 0.1);

    &:hover {
        background: var(--cpd-color-bg-action-primary-hovered);
    }
}

.mx_ThreadsView_loadMore {
    align-self: center;
    padding: var(--cpd-space-2x) var(--cpd-space-4x);
    border: 1px solid $separator;
    border-radius: var(--cpd-space-2x);
    color: $secondary-content;
    font: var(--cpd-font-body-sm-medium);

    &:hover {
        border-color: $accent;
        color: $primary-content;
    }
}

/* --- Individual thread cards --- */

.mx_ThreadCard {
    display: flex;
    flex-direction: column;
    gap: var(--cpd-space-2x);
    /* Keeps long threads readable rather than stretching across a wide window. Centred, rather
       than left with the leftover width piled up on one side: the cap is there for the sake of the
       line length, and a column pinned to one edge of a wide window just looks abandoned.
       Set here rather than as `align-items` on the scroller, which would also shrink-wrap the
       spinner, the empty state and the sticky new-activity bar. */
    max-width: 900px;
    width: 100%;
    margin-inline: auto;
    /* Unfolding a thread scrolls its card to the top of the scroller. Without this the card lands
       flush against the border, scrolling away the padding the feed is otherwise read through. */
    scroll-margin-block-start: var(--cpd-space-4x);
}

.mx_ThreadCard_roomHeader {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--cpd-space-2x);
    min-width: 0;
}

.mx_ThreadCard_roomButton {
    display: flex;
    align-items: center;
    gap: var(--cpd-space-2x);
    min-width: 0;
    padding: var(--cpd-space-1x) var(--cpd-space-2x);
    margin-inline-start: calc(-1 * var(--cpd-space-2x));
    border-radius: var(--cpd-space-2x);
    color: $primary-content;
    font: var(--cpd-font-body-md-semibold);

    &:hover {
        background-color: $quinary-content;
    }
}

.mx_ThreadCard_roomName {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* Its own line under the room name, as in Slack. Sharing the row squeezes it out of existence
   as soon as the room name is long enough to need ellipsizing. */
.mx_ThreadCard_participants {
    flex-basis: 100%;
    color: $secondary-content;
    font: var(--cpd-font-body-sm-regular);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* Plain text rather than a chip: the dot beside it is already the header's attention mark, and a
   second bordered thing next to it would compete for the same glance. */
.mx_ThreadCard_unreplied {
    flex-shrink: 0;
    color: $secondary-content;
    font: var(--cpd-font-body-sm-medium);
}

/* Pushed to the trailing edge, taking the menu and collapse control after it. */
.mx_ThreadCard_lastActivity {
    margin-inline-start: auto;
    flex-shrink: 0;
    color: $secondary-content;
    font: var(--cpd-font-body-sm-regular);
}

/* Revealed on hover, so that a stack of cards reads as a list of conversations rather than a list
   of buttons. Faded rather than removed from the layout, both so the header does not reflow under
   the pointer and so the control keeps its place in the tab order: `visibility: hidden` and
   `display: none` would each take it out of reach of the keyboard entirely. */
.mx_ThreadCard_menuButton {
    opacity: 0;
    flex-shrink: 0;

    .mx_ThreadCard:hover &,
    .mx_ThreadCard:focus-within &,
    &[data-open] {
        opacity: 1;
    }

    /* Nothing hovers on a touch screen, so hiding it there makes it both undiscoverable and an
       invisible tap target sitting next to the timestamp. */
    @media (hover: none) {
        opacity: 1;
    }
}

.mx_ThreadCard_body {
    display: flex;
    flex-direction: column;
    border: 1px solid $separator;
    border-radius: var(--cpd-space-3x);
    /* Lifted off the scroller's surface rather than sunk into it: a card is where the conversation
       is, so it takes the same background the timeline has in a room. */
    background-color: $background;
    padding: var(--cpd-space-3x) 0;
    overflow: hidden;
}

/* Raised rather than ringed. Which card is open is already obvious from the composer and the full
   run of replies, so an accent border only adds a heavy coloured box to a view whose whole point
   is a quiet stack of cards. Literal shadow because Compound exposes no token for one.

   The border is darkened as well, because a shadow this soft is all but invisible against a dark
   theme's background and the state would otherwise be carried by the composer alone. */
.mx_ThreadCard_expanded .mx_ThreadCard_body {
    box-shadow: 0 4px 24px 0 rgb(27, 29, 34, 0.1);
    border-color: $quinary-content;
}

/* EventTile renders as an li in thread mode, so the events are a real list. */
.mx_ThreadCard_events {
    list-style: none;
    margin: 0;
    padding: 0;
}

/* A control sitting between events in that list, carrying none of its appearance. */
.mx_ThreadCard_control {
    display: flex;
    list-style: none;
}

/* Text links: a count of replies or a collapse control does not deserve a box next to the messages
   themselves. */
.mx_ThreadCard_collapse,
.mx_ThreadCard_loadEarlier,
.mx_ThreadCard_showMore {
    padding: 0;
    color: $accent;

    &:hover {
        text-decoration: underline;
    }

    &:disabled {
        color: $secondary-content;
        text-decoration: none;
        cursor: default;
    }
}

/* These two sit in among the messages, so they take the size of the message text and start on the
   avatars' edge rather than the text's: indenting them to the text column made them read as a
   caption hanging off the messages instead of a line of the conversation. The indent is the same
   padding the event tiles carry, which is what puts the avatars where they are. */
.mx_ThreadCard_showMore,
.mx_ThreadCard_loadEarlier {
    align-self: flex-start;
    /* Logical, because the point of the inset is to line up with the avatars, and in an RTL
       layout the avatars are on the other side. */
    margin-block: var(--cpd-space-1x);
    margin-inline: var(--cpd-space-2x) var(--cpd-space-4x);
    font: var(--cpd-font-body-md-medium);
}

/* Grouped with the replies it reveals rather than with the message it follows, which needs more
   room above the link than below it. */
.mx_ThreadCard_showMore {
    margin-block: var(--cpd-space-4x) 0;
}

/* The space below the link comes from the following tile's own padding, so the tile gives most of
   it up. Reaching down from the link with a negative margin would close the same gap, but it lays
   the tile's box over the link and the tile takes the clicks with it. */
.mx_ThreadCard_events .mx_ThreadCard_control + .mx_EventTile[data-layout="group"] {
    padding-block-start: var(--cpd-space-1x);
}

/* This one sits in the card header, next to the timestamp, and takes its size from there. */
.mx_ThreadCard_collapse {
    flex-shrink: 0;
    font: var(--cpd-font-body-sm-medium);
}

.mx_ThreadCard_replyPrompt {
    margin: var(--cpd-space-2x) var(--cpd-space-4x) 0;
    padding: var(--cpd-space-2x) var(--cpd-space-3x);
    border: 1px solid $separator;
    border-radius: var(--cpd-space-2x);
    color: $secondary-content;
    font: var(--cpd-font-body-sm-regular);
    text-align: start;

    &:hover {
        border-color: $accent;
        color: $primary-content;
    }
}

/* The composer is designed to sit at the bottom of a panel, so soften the seam where it
 * meets the bottom of a card. */
.mx_ThreadCard .mx_MessageComposer {
    padding: 0 var(--cpd-space-3x);
}
