.mx_ThreadsNavButton {
    /* !important override compound */
    border-radius: 8px !important;
    margin: 18px auto auto auto;

    &.mx_ThreadsNavButton_expanded {
        /**
         * override compound default background color when hovered
         * should disappear when the space panel will be migrated to compound
         */
        background-color: transparent !important;

        /* align with settings icon */
        margin-left: 21px;
        margin-right: 8px;
        width: 100%;

        /**
         * modify internal css of the compound component
         * dirty but we need to add the `Threads` label into the indicator icon button
         **/
        & > div {
            display: flex;
            align-items: center;

            &::before {
                inline-size: 8px;
                block-size: 8px;
                left: 17px;
            }
        }

        & .mx_ThreadsNavButton_icon {
            /* align with settings label */
            margin-right: 14px;
            /* required to set the icon width when into a flex container */
            width: 24px;
            flex-shrink: 0;
        }

        & .mx_ThreadsNavButton_label {
            /* !important override compound  */
            color: $secondary-content !important;
        }
    }

    &:not(.mx_ThreadsNavButton_expanded) {
        &:hover,
        &:hover .mx_ThreadsNavButton_icon {
            /* !important override compound */
            background-color: $quaternary-content !important;
            fill: $primary-content;
        }
    }

    & .mx_ThreadsNavButton_icon {
        fill: $secondary-content;
    }

    /* Toggled-on state. The background is the one the panel puts behind a selected space, but at
       collapsed width that wash sits behind an icon rather than an avatar and barely registers, so
       the icon also takes the accent colour Element uses elsewhere for a control whose view is the
       one currently showing. Held through hover as well, since the icon losing its colour under the
       pointer would read as the button turning off. */
    &.mx_ThreadsNavButton_active {
        background-color: $panel-actions !important;

        & .mx_ThreadsNavButton_icon,
        &:hover .mx_ThreadsNavButton_icon {
            fill: var(--cpd-color-icon-accent-primary);
        }

        & .mx_ThreadsNavButton_label {
            color: $primary-content !important;
        }
    }
}
