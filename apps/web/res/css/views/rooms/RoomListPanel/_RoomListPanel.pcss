.mx_RoomListPanel {
    background-color: var(--cpd-color-bg-canvas-default);
    height: 100%;
}

/*
 * The compact layout. The shared room list shrinks the row and publishes the avatar size it wants
 * as --room-list-avatar-size; the avatar itself is rendered by the app, so applying that size is
 * this side's job.
 */
[data-density="compact"] .mx_RoomListItemView {
    .mx_RoomAvatarView {
        --room-avatar-size: var(--room-list-avatar-size, 32px);
    }

    /* The component sets --cpd-avatar-size inline from its size prop, so this has to shout to be
       heard. The container and the fallback initial derive from it; the image does not, quite. */
    .mx_BaseAvatar {
        --cpd-avatar-size: var(--room-list-avatar-size, 32px) !important;

        /* Compound centres the fallback initial by giving it a line box of size - 2px, which only
           comes out centred if a 1px border eats that difference. This avatar has no border, so the
           2px collects under the line box instead and the initial sits high: 1px at 32px, where it
           passes unnoticed, but 1.5px of 26px here, which reads as visibly off. */
        line-height: var(--cpd-avatar-size);
    }

    /* The image carries width and height attributes stamped from that same size prop, and Compound's
       own rule overrides only the width. Left alone, the height stays at the prop's 32px while the
       width shrinks, so the image is scaled to cover a portrait box and cropped off centre. */
    .mx_BaseAvatar img {
        block-size: var(--cpd-avatar-size);
    }
}
